# Server — App de Matrícula de Estudiantes (La Salle)
# Puerto del servidor (según pizarra: 3001)
PORT=3001

# MySQL (según pizarra: puerto 3306, usuario root, contraseña admin)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=admin
DB_NAME=matricula_db

# Origen permitido (client en puerto 3000)
CLIENT_URL=http://localhost:3000
